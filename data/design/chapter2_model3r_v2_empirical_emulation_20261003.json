  "visitor_assembly": {
    "climate_suitability": "exp(-0.5 * sum(((PC-center)/(climate_width*climate_scale))^2))",
    "reach": "exp(-distance_km/(dispersal_scale_km*dispersal_multiplier))",
    "arrival_rate": "presence_intensity * source_abundance * climate_suitability * reach",
    "stationary_presence": "arrival_rate / (arrival_rate + baseline_loss_hazard*(1 + isolation_turnover*distance_quantile))",
    "annual_realization": "fixed uniform random numbers thresholded by stationary_presence; random numbers fixed before fitting",
    "local_service_if_present": "source_abundance * climate_suitability * effectiveness",
    "rationale": "isolation changes both visitor amount and identity/turnover rather than only scaling total activity"
  },
  "plant_lineages": {
    "preflight_lineages_per_island": 4,
    "confirmatory_lineages_per_island": 8,
    "initial_state_seed": 32004,
    "initial_matching_center": "Uniform(0.15,0.85)",
    "initial_generalization": "Uniform(0.10,0.40)",
    "initial_display": "Uniform(0.35,0.65)",
    "initial_assurance": "Uniform(0.03,0.30)",
    "evolvability_multiplier": "Uniform(0.6,1.4)",
    "interpretation": "within-island species/lineage heterogeneity retained so H4 is estimated within shared geographic conditions"
  },
  "annual_environment": {
    "preflight_years_per_selection_step": 6,
    "confirmatory_years_per_selection_step": 12,
    "random_seed": 32005
  },
  "evolutionary_operator": {
    "traits": [
      "matching_center_m",
      "generalization_g",
      "display_d",
      "assurance_a"
    ],
    "generalization_width": "g_min + g_scale*g",
    "affinity": "(0.1+d)*exp(-((m-theta)/sqrt(visitor_breadth^2+generalization_width^2))^2)",
    "ovules": "8*exp(-c_display*d^2-c_generalization*g^2-c_assurance*a^2)",
    "outcross_fraction": "1-exp(-service/pollen_scale)",
    "selfed_viable_fraction": "a*(1-outcross_fraction)*(1-inbreeding_depression)",
    "fitness": "maternal_viable + paternal_weight*ovules*outcross_fraction",
    "pollen_limitation": "log(ovules/natural_maternal_viable), evaluated across current annual visitor realizations",
    "adaptation": "Euler updates along numerical log-fitness gradients, bounded to [0,1]"
  },
  "stage1_search": {
