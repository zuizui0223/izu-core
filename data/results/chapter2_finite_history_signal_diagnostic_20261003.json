  "interpretation": {
    "main": "Sign-level parallelism and continuous history repeatability are not equivalent diagnostics.",
    "natural": "The natural finite bridge contains a reproducible visitor-history component in continuous effect magnitude despite substantial demographic-repeat noise.",
    "large_capacity": "Increasing capacity reduces sign heterogeneity and demographic residual variance while increasing the reproducibility of history-specific continuous effects.",
    "pooled_visitors": "Pooling visitor histories also removes mean sign heterogeneity, but it strongly reduces the reproducible history component instead of merely reducing demographic noise.",
    "consequence": "The same apparent increase in directional parallelism can arise either while historical imprint becomes more reproducible or while historical imprint is averaged away."
  },
  "claim_boundary": [
    "Exploratory post-hoc diagnostic; not a preregistered confirmatory test.",
    "Do not interpret variance components as natural prevalence or natural heritability.",
    "Do not treat capacity scaling as a pure sample-size change or visitor pooling as a pure noise intervention.",
    "Use this result to distinguish repeatability metrics and mechanisms, not to rank natural evolutionary causes."
  ]
